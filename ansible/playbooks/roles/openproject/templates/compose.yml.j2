# Generated by Ansible; use scripts/op-*.sh for lifecycle operations.
x-app: &app
  image: {{ op_images.app | to_json }}
  restart: unless-stopped
  env_file:
    - path: ./openproject.env
      format: raw
  volumes:
    - opdata:/var/openproject/assets
  networks:
    - backend
  logging:
    driver: json-file
    options:
      max-size: '10m'
      max-file: '3'

services:
  db:
    image: {{ op_images.db | to_json }}
    restart: unless-stopped
    environment:
      POSTGRES_PASSWORD: {{ op_data.op.db_password | to_json }}
      POSTGRES_DB: openproject
    volumes:
      - pgdata:/var/lib/postgresql/data
    networks: [backend]
    healthcheck:
      test: [CMD-SHELL, 'pg_isready -U postgres -d openproject']
      interval: 5s
      timeout: 5s
      retries: 30
  cache:
    image: {{ op_images.cache | to_json }}
    restart: unless-stopped
    networks: [backend]
  seeder:
    <<: *app
    command: ['./docker/prod/seeder']
    restart: 'no'
    profiles: [tools]
  web:
    <<: *app
    command: ['./docker/prod/web']
    networks:
      backend:
        aliases: [{{ op_web_alias | to_json }}]
      traefik: {}
    healthcheck:
      test: [CMD, curl, '-fsS', 'http://localhost:8080/health_checks/default']
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 60s
    labels:
      traefik.enable: 'true'
      traefik.docker.network: traefik
      traefik.http.services.{{ op_project }}.loadbalancer.server.port: '8080'
      traefik.http.routers.{{ op_project }}.rule: 'Host(`{{ target_domain }}`)'
      traefik.http.routers.{{ op_project }}.entrypoints: websecure
      traefik.http.routers.{{ op_project }}.service: {{ op_project }}
      traefik.http.routers.{{ op_project }}.tls: 'true'
      traefik.http.routers.{{ op_project }}.tls.certresolver: {{ 'letsEncryptDns' if op_data.op.wildcard_domain else 'letsEncrypt' }}
{% if op_data.op.wildcard_domain %}
      traefik.http.routers.{{ op_project }}.tls.domains[0].main: {{ op_data.op.wildcard_domain }}
      traefik.http.routers.{{ op_project }}.tls.domains[0].sans: '*.{{ op_data.op.wildcard_domain }}'
{% endif %}
{% if op_data.op.middleware %}
      traefik.http.routers.{{ op_project }}.middlewares: {{ op_data.op.middleware | to_json }}
{% endif %}
      traefik.http.middlewares.{{ op_project }}-https.redirectscheme.scheme: https
      traefik.http.routers.{{ op_project }}-http.rule: 'Host(`{{ target_domain }}`)'
      traefik.http.routers.{{ op_project }}-http.entrypoints: web
      traefik.http.routers.{{ op_project }}-http.middlewares: {{ op_project }}-https
      traefik.http.routers.{{ op_project }}-http.service: noop@internal
  worker:
    <<: *app
    command: ['./docker/prod/worker']
  cron:
    <<: *app
    command: ['./docker/prod/cron']
  hocuspocus:
    image: {{ op_images.hocuspocus | to_json }}
    restart: unless-stopped
    environment:
      SECRET: {{ op_data.op.collaborative_secret | to_json }}
      OPENPROJECT_URL: 'http://{{ op_web_alias }}:8080'
      OPENPROJECT_HTTPS: 'true'
    networks: [backend, traefik]
    labels:
      traefik.enable: 'true'
      traefik.docker.network: traefik
      traefik.http.services.{{ op_project }}-collab.loadbalancer.server.port: '1234'
      traefik.http.routers.{{ op_project }}-collab.rule: 'Host(`{{ target_domain }}`) && PathPrefix(`/hocuspocus`)'
      traefik.http.routers.{{ op_project }}-collab.priority: '200'
      traefik.http.routers.{{ op_project }}-collab.entrypoints: websecure
      traefik.http.routers.{{ op_project }}-collab.service: {{ op_project }}-collab
      traefik.http.routers.{{ op_project }}-collab.tls: 'true'
      traefik.http.routers.{{ op_project }}-collab.tls.certresolver: {{ 'letsEncryptDns' if op_data.op.wildcard_domain else 'letsEncrypt' }}
{% if op_data.op.middleware %}
      traefik.http.routers.{{ op_project }}-collab.middlewares: {{ op_data.op.middleware | to_json }}
{% endif %}
networks:
  backend: {}
  traefik:
    external: true
    name: traefik
volumes:
  pgdata: {}
  opdata: {}
