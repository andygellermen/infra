    },
    {
      "id": "WING_SCORE_EVALUATES_TEXT",
      "editable": false,
      "enforced_by": [
        "CORE",
        "PRESENTATION"
      ],
      "description": "Ein WingScore beschreibt ausschließlich den analysierten Text, nie den Menschen."
    },
    {
