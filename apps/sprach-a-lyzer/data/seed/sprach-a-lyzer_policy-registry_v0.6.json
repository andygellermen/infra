    {
      "id": "PROPOSITION_SPAN_MUST_MATCH_SOURCE",
      "editable": false,
      "enforced_by": [
        "RESOLVER",
        "CONTRACT",
        "GOLDEN"
      ],
      "description": "Jede Proposition muss exakt auf ihren halb-offenen UTF-8-Bytebereich im Quelltext zurückführbar sein."
    },
    {
      "id": "RESOLVER_CANDIDATE_CANNOT_BYPASS_RULES",
      "editable": false,
      "enforced_by": [
        "RESOLVER",
        "CORE",
        "GOLDEN"
      ],
      "description": "Resolver-Kandidaten werden nicht ungeprüft zu aktiven Rule-Pattern oder Contributions."
    },
    {
      "id": "CONSTRUCT_REQUIRES_EXPLICIT_EVIDENCE",
      "editable": false,
      "reason": "A construct requires versioned positive evidence and cannot be inferred from missing evidence."
    },
    {
      "id": "WORKING_HYPOTHESIS_REQUIRES_HEDGING",
      "editable": false,
      "reason": "Working hypotheses may only be exposed as qualified hypotheses or reflection prompts."
    },
    {
      "id": "REFLECTIVE_CONSTRUCT_CANNOT_SCORE",
      "editable": false,
      "reason": "Reflective and spiritual constructs never contribute to deterministic core scores."
    }
