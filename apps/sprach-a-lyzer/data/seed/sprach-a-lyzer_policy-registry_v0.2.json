    "question_canonical": "0.1",
    "question_rendering": "0.1",
    "knowledge_base": "0.1",
    "rule_set": "0.2",
    "parameter_set": "0.1",
    "presentation_bundle": "0.1",
    "golden_suite": "0.2"
  },
  "privacy_defaults": {
    "raw_text_retention": "DISCARD_AFTER_ANALYSIS",
    "analysis_storage": false,
    "raw_audio_storage": false,
    "personal_history": "EXPLICIT_OPT_IN",
    "manager_individual_access": false,
    "employee_ranking": false,
    "hr_selection_use": false
  },
  "feature_flags": [
    {"id": "AI_EXPLANATION", "default": false, "stage": "OPTIONAL_PREVIEW"},
    {"id": "AI_REPHRASING", "default": false, "stage": "OPTIONAL_PREVIEW"},
    {"id": "AI_ADAPTIVE_QUESTION", "default": false, "stage": "LATER"},
    {"id": "LOCAL_LLM", "default": false, "stage": "LATER"},
    {"id": "CLOUD_LLM", "default": false, "stage": "LATER"},
    {"id": "LOCAL_ASR", "default": false, "stage": "LATER"},
    {"id": "PROSODY_ANALYSIS", "default": false, "stage": "LATER"},
    {"id": "STORE_RAW_TEXT", "default": false, "stage": "EXPLICIT_OPT_IN_ONLY"},
    {"id": "STORE_AUDIO", "default": false, "stage": "EXPLICIT_OPT_IN_ONLY"}
  ],
  "hard_guardrails": [
    {"id": "MISSING_EVIDENCE_IS_NULL", "editable": false, "enforced_by": ["CORE", "CONTRACT", "GOLDEN"], "description": "Fehlende Evidenz erzeugt NOT_ASSESSABLE und score null, niemals einen neutralen Scheinwert."},
    {"id": "SCORE_IS_BOUNDED", "editable": false, "enforced_by": ["CORE", "CONTRACT"], "description": "Öffentliche Dimensionsscores liegen zwischen 0 und 100."},
    {"id": "CONFIDENCE_IS_BOUNDED", "editable": false, "enforced_by": ["CORE", "CONTRACT"], "description": "Confidence und Assessability liegen zwischen 0 und 1."},
    {"id": "CALCULATIONS_ARE_FINITE", "editable": false, "enforced_by": ["CORE"], "description": "NaN, Infinity und Division durch null sind unzulässig."},
    {"id": "NO_CIRCULAR_RULE_CHAINS", "editable": false, "enforced_by": ["IMPORT", "PUBLISH"], "description": "Regelabhängigkeiten dürfen keinen Zyklus bilden."},
    {"id": "NO_INFINITE_MODIFIER_CHAINS", "editable": false, "enforced_by": ["CORE", "PUBLISH"], "description": "Modifier-Ketten sind endlich und besitzen ein festes Ausführungslimit."},
    {"id": "NO_SEMANTIC_HOMOPHONE_INHERITANCE", "editable": false, "enforced_by": ["CORE", "GOLDEN"], "description": "Homophone Beziehungen übertragen keine Semantik und keinen Dimensionsbeitrag."},
    {"id": "NO_PERSON_DIAGNOSIS", "editable": false, "enforced_by": ["CORE", "PRESENTATION", "AI_ADAPTER"], "description": "Die Engine erzeugt keine Diagnose über einen Menschen."},
    {"id": "NO_TRAIT_CLAIMS", "editable": false, "enforced_by": ["CORE", "PRESENTATION", "AI_ADAPTER"], "description": "Textbeobachtungen werden nicht als stabile Persönlichkeitseigenschaften ausgegeben."},
    {"id": "NO_EMPLOYEE_RANKING", "editable": false, "enforced_by": ["CORE", "CORPORATE", "EXPORT"], "description": "Individuelle Beschäftigte werden niemals gerankt."},
    {"id": "QUESTION_SCORE_BIAS_IS_ZERO", "editable": false, "enforced_by": ["Q_A_ENGINE", "CONTRACT", "GOLDEN"], "description": "Eine Frage addiert oder subtrahiert selbst keinen Dimensionsscore."},
    {"id": "QUESTION_ALONE_IS_NOT_ASSESSABLE", "editable": false, "enforced_by": ["Q_A_ENGINE", "GOLDEN"], "description": "Fragekontext allein erzeugt keine Bewertbarkeit."},
    {"id": "RESONANCE_DOES_NOT_SCORE_CORE", "editable": false, "enforced_by": ["CORE", "GOLDEN"], "description": "Resonanzhinweise erzeugen im Standardmodus keinen semantischen Kernscore."},
    {"id": "CORPORATE_HAS_NO_CANONICAL_FALLBACK", "editable": false, "enforced_by": ["PRESENTATION", "BUILD", "GOLDEN"], "description": "Corporate-Ausgaben fallen niemals auf interne oder private Canonical Labels zurück."},
    {"id": "LLM_CANNOT_SCORE", "editable": false, "enforced_by": ["AI_ADAPTER", "CORE"], "description": "Ein LLM darf keine Scores, Evidenzklassen oder Guardrails autonom verändern."},
    {"id": "WING_SCORE_EVALUATES_TEXT", "editable": false, "enforced_by": ["CORE", "PRESENTATION"], "description": "Ein WingScore beschreibt ausschließlich den analysierten Text, nie den Menschen."},
    {"id": "RAW_TEXT_STORAGE_REQUIRES_OPT_IN", "editable": false, "enforced_by": ["API", "PERSISTENCE", "CORPORATE"], "description": "Rohtextspeicherung benötigt eine ausdrückliche, zweckgebundene Zustimmung."},
    {"id": "RAW_AUDIO_STORAGE_REQUIRES_OPT_IN", "editable": false, "enforced_by": ["API", "PERSISTENCE"], "description": "Audio wird nur nach ausdrücklicher, zweckgebundener Zustimmung gespeichert."}
  ],
  "soft_guardrails": [
    {"id": "WARN_BASE_CONTRIBUTION_ABOVE_50", "parameter_key": "rule.base_contribution_abs", "warn_above": 50.0, "requires_approval": true},
    {"id": "WARN_RESONANCE_FACTOR_ABOVE_0_6", "parameter_key": "resonance.factor", "warn_above": 0.6, "requires_approval": true},
    {"id": "WARN_FREQUENCY_ALPHA_ABOVE_0_5", "parameter_key": "frequency.alpha", "warn_above": 0.5, "requires_approval": true}
  ]
}
