    "inference_classes": ["OBSERVABLE", "INFERABLE", "WORKING_HYPOTHESIS", "REFLECTIVE_ONLY"],
    "causal_levels": ["C0", "C1", "C2", "C3", "C4"],
    "target_types": ["PERSON", "SELF", "BEHAVIOR", "PROCESS", "EVENT", "OBJECT", "IDEA", "GROUP", "INSTITUTION", "UNKNOWN"],
    "expectation_sources": ["SELF", "OTHER_PERSON", "GROUP", "INSTITUTION", "LAW", "CULTURE", "UNSPECIFIED", "INTERNALIZED"],
    "discourse_relations": ["CONTRAST", "CONCESSION", "CAUSE", "CONSEQUENCE", "ADDITION", "CONDITION", "CORRECTION", "DISCOUNTING"],
    "rule_scopes": ["TEXT", "QUESTION_ANSWER", "SPOKEN_DICTATION"],
    "rule_statuses": ["DRAFT", "TESTING", "APPROVED", "PRODUCTION", "ARCHIVED"],
    "rule_action_types": ["ADD_CONTRIBUTION", "MULTIPLY_CONTRIBUTION", "CAP_MIN", "CAP_MAX", "SET", "INVERT", "SUPPRESS", "ADD_PATTERN", "ADD_EXPLANATION", "ADD_REFLECTION_PROMPT", "MARK_NON_ASSESSABLE", "SELECT_SENSE", "ADD_RESONANCE_HINT", "STOP_RULE_CHAIN"]
  },
  "version_contract": {
    "analysis_request": "0.1",
    "analysis_result": "0.1",
    "analysis_trace": "0.1",
