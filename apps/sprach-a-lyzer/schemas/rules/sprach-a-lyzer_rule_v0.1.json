{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meinesprache.org/schemas/sprach-a-lyzer/rule-v0.1.json",
  "title": "Sprach-A-Lyzer Rule v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "key", "name", "priority", "condition", "actions"],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "key": {"type": "string", "pattern": "^R-[A-Z0-9-]+$"},
    "name": {"type": "string", "minLength": 1},
    "priority": {"type": "integer"},
    "condition": {"type": "object", "minProperties": 1},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object", "minProperties": 1}
    }
  }
}
