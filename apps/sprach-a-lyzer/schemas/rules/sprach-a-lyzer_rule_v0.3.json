{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meinesprache.org/schemas/sprach-a-lyzer/rule-v0.3.json",
  "title": "Sprach-A-Lyzer Rule v0.3",
  "description": "Strict canonical rule contract. Hard guardrails are outside editable rule data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "id", "key", "name", "description", "priority", "enabled", "scope", "status", "version", "condition", "actions", "confidence_modifier", "stop_processing"],
  "properties": {
    "contract_version": {"const": "0.3"},
    "id": {"type": "string", "format": "uuid"},
    "key": {"type": "string", "pattern": "^R-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "priority": {"type": "integer", "minimum": 0, "maximum": 10000},
    "enabled": {"type": "boolean"},
    "scope": {"enum": ["TEXT", "QUESTION_ANSWER", "SPOKEN_DICTATION"]},
    "status": {"enum": ["DRAFT", "TESTING", "APPROVED", "PRODUCTION", "ARCHIVED"]},
    "version": {"type": "integer", "minimum": 1},
    "evidence_class": {"enum": ["A", "B", "C", "D", "E"]},
    "source_keys": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "condition": {"$ref": "#/$defs/conditionNode"},
    "actions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/action"}},
    "confidence_modifier": {"type": "number", "minimum": 0, "maximum": 1},
    "stop_processing": {"type": "boolean"}
  },
  "$defs": {
    "dimensionID": {"enum": ["AGENCY", "CONNECTION", "APPRECIATION", "CLARITY", "VOLITION", "OPENNESS"]},
    "conditionNode": {
      "oneOf": [
        {"$ref": "#/$defs/allOrAnyCondition"},
        {"$ref": "#/$defs/notCondition"},
        {"$ref": "#/$defs/predicate"}
      ]
    },
    "allOrAnyCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "children"],
      "properties": {
        "op": {"enum": ["AND", "OR"]},
        "children": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/conditionNode"}}
      }
    },
    "notCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "child"],
      "properties": {
        "op": {"const": "NOT"},
        "child": {"$ref": "#/$defs/conditionNode"}
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator"],
      "properties": {
        "field": {"enum": ["selected_sense", "tokens", "phrase", "context", "input_mode", "target_type", "expectation_source", "discourse_relation", "pattern", "proposition_feature"]},
        "operator": {"enum": ["EQUALS", "NOT_EQUALS", "CONTAINS", "CONTAINS_ANY", "CONTAINS_ALL", "MATCHES", "EXISTS", "NOT_EXISTS"]},
        "value": {},
        "case_sensitive": {"type": "boolean", "default": false}
      },
      "allOf": [
        {
          "if": {"properties": {"operator": {"enum": ["EXISTS", "NOT_EXISTS"]}}, "required": ["operator"]},
          "then": {"not": {"required": ["value"]}},
          "else": {"required": ["value"]}
        }
      ]
    },
    "action": {
      "oneOf": [
        {"$ref": "#/$defs/addContribution"},
        {"$ref": "#/$defs/factorAction"},
        {"$ref": "#/$defs/valueAction"},
        {"$ref": "#/$defs/dimensionOnlyAction"},
        {"$ref": "#/$defs/keyAction"},
        {"$ref": "#/$defs/selectSenseAction"},
        {"$ref": "#/$defs/resonanceHintAction"},
        {"$ref": "#/$defs/terminalAction"}
      ]
    },
    "addContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "dimension", "value", "reason_key"],
      "properties": {
        "type": {"const": "ADD_CONTRIBUTION"},
        "dimension": {"$ref": "#/$defs/dimensionID"},
        "value": {"type": "number", "minimum": -100, "maximum": 100},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "reason_key": {"type": "string", "minLength": 1}
      }
    },
    "factorAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "dimension", "factor", "reason_key"],
      "properties": {
        "type": {"const": "MULTIPLY_CONTRIBUTION"},
        "dimension": {"$ref": "#/$defs/dimensionID"},
        "factor": {"type": "number", "minimum": 0, "maximum": 10},
        "reason_key": {"type": "string", "minLength": 1}
      }
    },
    "valueAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "dimension", "value", "reason_key"],
      "properties": {
        "type": {"enum": ["CAP_MIN", "CAP_MAX", "SET"]},
        "dimension": {"$ref": "#/$defs/dimensionID"},
        "value": {"type": "number", "minimum": -100, "maximum": 100},
        "reason_key": {"type": "string", "minLength": 1}
      }
    },
    "dimensionOnlyAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "dimension", "reason_key"],
      "properties": {
        "type": {"enum": ["INVERT", "SUPPRESS", "MARK_NON_ASSESSABLE"]},
        "dimension": {"$ref": "#/$defs/dimensionID"},
        "reason_key": {"type": "string", "minLength": 1}
      }
    },
    "keyAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "key"],
      "properties": {
        "type": {"enum": ["ADD_PATTERN", "ADD_EXPLANATION", "ADD_REFLECTION_PROMPT"]},
        "key": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
      }
    },
    "selectSenseAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "lexeme", "sense"],
      "properties": {
        "type": {"const": "SELECT_SENSE"},
        "lexeme": {"type": "string", "minLength": 1},
        "sense": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
      }
    },
    "resonanceHintAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "tokens", "semantic_score"],
      "properties": {
        "type": {"const": "ADD_RESONANCE_HINT"},
        "tokens": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "semantic_score": {"const": false},
        "message_key": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
      }
    },
    "terminalAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {"type": {"const": "STOP_RULE_CHAIN"}}
    }
  }
}
